[Unit]
Description=QuietContext shared MCP daemon (Streamable HTTP on 127.0.0.1)

[Service]
Type=exec
Environment=QUIET_CONTEXT_DAEMON_PORT=48619
# This user unit is the Claude Code shared-daemon deployment path.
# Pin storage/platform selection so unrelated agent config dirs on the machine
# cannot redirect durable project indexes at daemon startup.
Environment=QUIET_CONTEXT_PLATFORM=claude-code
WorkingDirectory=%h/.claude/plugins/sources/quietmode
ExecStart=/usr/bin/node %h/.claude/plugins/sources/quietmode/start-http.mjs
Restart=on-failure
RestartSec=2
TimeoutStopSec=15

[Install]
WantedBy=default.target
